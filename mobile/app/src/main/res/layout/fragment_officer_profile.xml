<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F6FB">

    <!-- Header -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/officerProfileHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/pirma_blue"
        android:elevation="8dp"
        android:paddingTop="52dp"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tvOfficerProfileTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:fontFamily="serif"
            android:text="My Profile"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvOfficerProfileSubtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="20dp"
            android:text="Manage your officer account"
            android:textColor="#99FFFFFF"
            android:textSize="12sp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvOfficerProfileTitle"
            app:layout_constraintBottom_toTopOf="@id/officerProfileAccentLine" />

        <LinearLayout
            android:id="@+id/officerProfileAccentLine"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent">
            <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@color/pirma_blue" />
            <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@color/pirma_red" />
            <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@color/pirma_gold" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Scrollable Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/officerProfileHeader"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <ProgressBar
                android:id="@+id/pbOfficerProfile"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="40dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvOfficerProfileError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/pirma_red"
                android:gravity="center"
                android:layout_marginBottom="8dp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/officerProfileContentContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="visible">

                <!-- Profile Avatar Card -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_input_field"
                    android:backgroundTint="@color/white"
                    android:elevation="2dp"
                    android:layout_marginBottom="16dp">

                    <View
                        android:id="@+id/officerProfileCover"
                        android:layout_width="match_parent"
                        android:layout_height="64dp"
                        android:background="@drawable/bg_profile_cover_gradient"
                        app:layout_constraintTop_toTopOf="parent" />

                    <LinearLayout
                        android:id="@+id/officerCoverAccent"
                        android:layout_width="match_parent"
                        android:layout_height="4dp"
                        android:orientation="horizontal"
                        app:layout_constraintTop_toBottomOf="@id/officerProfileCover">
                        <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@color/pirma_blue" />
                        <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@color/pirma_red" />
                        <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@color/pirma_gold" />
                    </LinearLayout>

                    <FrameLayout
                        android:id="@+id/officerAvatarWrap"
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:layout_marginStart="20dp"
                        android:layout_marginTop="-36dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/officerProfileCover">

                        <TextView
                            android:id="@+id/tvOfficerInitials"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:text="OF"
                            android:textColor="@color/white"
                            android:textSize="24sp"
                            android:textStyle="bold"
                            android:background="@drawable/bg_btn_primary"
                            android:backgroundTint="@color/pirma_blue" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tvOfficerFullName"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="20dp"
                        android:layout_marginEnd="16dp"
                        android:layout_marginTop="12dp"
                        android:text="Barangay Officer"
                        android:textColor="@color/pirma_text_dark"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        app:layout_constraintStart_toEndOf="@id/officerAvatarWrap"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/officerCoverAccent" />

                    <TextView
                        android:id="@+id/tvOfficerRoleLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="20dp"
                        android:layout_marginEnd="16dp"
                        android:layout_marginTop="2dp"
                        android:text="Barangay Officer"
                        android:textColor="@color/pirma_text_muted"
                        android:textSize="13sp"
                        app:layout_constraintStart_toEndOf="@id/officerAvatarWrap"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tvOfficerFullName" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="20dp"
                        android:paddingEnd="16dp"
                        android:paddingTop="16dp"
                        android:paddingBottom="16dp"
                        android:layout_marginTop="40dp"
                        app:layout_constraintTop_toBottomOf="@id/officerAvatarWrap">

                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="10dp">
                            <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/ic_notifications" android:layout_marginEnd="10dp" android:layout_gravity="center_vertical" app:tint="@color/pirma_text_muted" />
                            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Email" android:textColor="@color/pirma_text_muted" android:textSize="11sp" />
                                <TextView android:id="@+id/tvOfficerEmail" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="N/A" android:textColor="@color/pirma_text_dark" android:textSize="13sp" android:textStyle="bold" />
                            </LinearLayout>
                        </LinearLayout>

                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="10dp">
                            <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/ic_person" android:layout_marginEnd="10dp" android:layout_gravity="center_vertical" app:tint="@color/pirma_text_muted" />
                            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Username" android:textColor="@color/pirma_text_muted" android:textSize="11sp" />
                                <TextView android:id="@+id/tvOfficerUsername" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="N/A" android:textColor="@color/pirma_text_dark" android:textSize="13sp" android:textStyle="bold" />
                            </LinearLayout>
                        </LinearLayout>

                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                            <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/ic_clock" android:layout_marginEnd="10dp" android:layout_gravity="center_vertical" app:tint="@color/pirma_text_muted" />
                            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Account Status" android:textColor="@color/pirma_text_muted" android:textSize="11sp" />
                                <TextView android:id="@+id/tvOfficerStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="N/A" android:textColor="@color/pirma_text_dark" android:textSize="13sp" android:textStyle="bold" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>

                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- Personal Information Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_input_field"
                    android:backgroundTint="@color/white"
                    android:elevation="2dp"
                    android:orientation="vertical"
                    android:layout_marginBottom="16dp">

                    <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="16dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Personal Information" android:textColor="@color/pirma_text_dark" android:textSize="15sp" android:textStyle="bold" />
                    </RelativeLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/pirma_border" />

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">

                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="First Name" android:textColor="@color/pirma_text_muted" android:textSize="12sp" android:layout_marginBottom="4dp" />
                        <TextView android:id="@+id/tvOfficerFirstName" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="—" android:textColor="@color/pirma_text_dark" android:textSize="14sp" android:background="@drawable/bg_input_field" android:padding="12dp" android:layout_marginBottom="12dp" />

                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Middle Name" android:textColor="@color/pirma_text_muted" android:textSize="12sp" android:layout_marginBottom="4dp" />
                        <TextView android:id="@+id/tvOfficerMiddleName" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="—" android:textColor="@color/pirma_text_dark" android:textSize="14sp" android:background="@drawable/bg_input_field" android:padding="12dp" android:layout_marginBottom="12dp" />

                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Last Name" android:textColor="@color/pirma_text_muted" android:textSize="12sp" android:layout_marginBottom="4dp" />
                        <TextView android:id="@+id/tvOfficerLastName" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="—" android:textColor="@color/pirma_text_dark" android:textSize="14sp" android:background="@drawable/bg_input_field" android:padding="12dp" android:layout_marginBottom="12dp" />

                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Email Address" android:textColor="@color/pirma_text_muted" android:textSize="12sp" android:layout_marginBottom="4dp" />
                        <TextView android:id="@+id/tvOfficerEmailDetail" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="—" android:textColor="@color/pirma_text_dark" android:textSize="14sp" android:background="@drawable/bg_input_field" android:padding="12dp" android:layout_marginBottom="4dp" />

                    </LinearLayout>
                </LinearLayout>

                <!-- Security Settings Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_input_field"
                    android:backgroundTint="@color/white"
                    android:elevation="2dp"
                    android:orientation="vertical"
                    android:layout_marginBottom="16dp">

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:padding="16dp">
                        <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/ic_notifications" android:layout_marginEnd="8dp" app:tint="@color/pirma_text_dark" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Security Settings" android:textColor="@color/pirma_text_dark" android:textSize="15sp" android:textStyle="bold" />
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/pirma_border" />

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">

                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Current Password" android:textColor="@color/pirma_text_muted" android:textSize="12sp" android:layout_marginBottom="4dp" />
                        <EditText android:id="@+id/etOfficerCurrentPassword" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textPassword" android:hint="Enter current password" android:background="@drawable/bg_input_field" android:padding="12dp" android:textSize="14sp" android:textColor="@color/pirma_text_dark" android:textColorHint="@color/pirma_placeholder" android:layout_marginBottom="12dp" />

                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="New Password" android:textColor="@color/pirma_text_muted" android:textSize="12sp" android:layout_marginBottom="4dp" />
                        <EditText android:id="@+id/etOfficerNewPassword" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textPassword" android:hint="At least 8 characters" android:background="@drawable/bg_input_field" android:padding="12dp" android:textSize="14sp" android:textColor="@color/pirma_text_dark" android:textColorHint="@color/pirma_placeholder" android:layout_marginBottom="12dp" />

                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Confirm New Password" android:textColor="@color/pirma_text_muted" android:textSize="12sp" android:layout_marginBottom="4dp" />
                        <EditText android:id="@+id/etOfficerConfirmPassword" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textPassword" android:hint="Repeat new password" android:background="@drawable/bg_input_field" android:padding="12dp" android:textSize="14sp" android:textColor="@color/pirma_text_dark" android:textColorHint="@color/pirma_placeholder" android:layout_marginBottom="16dp" />

                        <FrameLayout android:layout_width="match_parent" android:layout_height="48dp">
                            <Button android:id="@+id/btnOfficerUpdatePassword" android:layout_width="match_parent" android:layout_height="match_parent" android:text="Update Password" android:textColor="@color/white" android:background="@drawable/bg_btn_primary" android:textStyle="bold" android:textSize="14sp" />
                            <ProgressBar android:id="@+id/pbOfficerPasswordUpdate" android:layout_width="24dp" android:layout_height="24dp" android:layout_gravity="center" android:indeterminateTint="@color/white" android:visibility="gone" />
                        </FrameLayout>

                    </LinearLayout>
                </LinearLayout>

                <!-- Logout Button -->
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnOfficerLogout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_btn_danger"
                    android:text="Log Out"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05"
                    android:padding="16dp"
                    android:layout_marginBottom="16dp" />

            </LinearLayout>
        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
