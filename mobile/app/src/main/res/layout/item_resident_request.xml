<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_input_field"
    android:backgroundTint="@color/white"
    android:elevation="1dp"
    android:padding="16dp">

    <View
        android:id="@+id/statusAccent"
        android:layout_width="4dp"
        android:layout_height="0dp"
        android:background="@color/pirma_blue"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvRequestId"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:text="REQ-12345"
        android:textColor="@color/pirma_text_muted"
        android:textSize="12sp"
        app:layout_constraintStart_toEndOf="@id/statusAccent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvDate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Oct 12, 2026"
        android:textColor="@color/pirma_text_muted"
        android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvDocumentType"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="4dp"
        android:text="Barangay Clearance"
        android:textColor="@color/pirma_text_dark"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@+id/tvStatus"
        app:layout_constraintStart_toEndOf="@id/statusAccent"
        app:layout_constraintTop_toBottomOf="@id/tvRequestId" />

    <TextView
        android:id="@+id/tvPurpose"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="2dp"
        android:text="Employment"
        android:textColor="@color/pirma_text_muted"
        android:textSize="13sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/statusAccent"
        app:layout_constraintTop_toBottomOf="@id/tvDocumentType" />

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_btn_secondary"
        android:backgroundTint="#201E3A8A"
        android:paddingHorizontal="10dp"
        android:paddingVertical="4dp"
        android:text="Pending"
        android:textColor="@color/pirma_blue"
        android:textSize="12sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@+id/tvDocumentType"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tvDocumentType" />

</androidx.constraintlayout.widget.ConstraintLayout>
