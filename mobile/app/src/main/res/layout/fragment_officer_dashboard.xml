<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F6FB">

    <!-- Header -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/officerDashboardHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/pirma_blue"
        android:elevation="8dp"
        android:paddingTop="52dp"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tvDashboardTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:fontFamily="serif"
            android:text="Dashboard"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvDashboardSubtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="16dp"
            android:text="Overview of all document requests"
            android:textColor="#99FFFFFF"
            android:textSize="12sp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvDashboardTitle"
            app:layout_constraintBottom_toTopOf="@id/dashboardHeaderAccent" />

        <LinearLayout
            android:id="@+id/dashboardHeaderAccent"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent">
            <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@color/pirma_blue" />
            <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@color/pirma_red" />
            <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@color/pirma_gold" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Content area (below header): FrameLayout so loading overlay can sit on top -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/officerDashboardHeader"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Scrollable Content (hidden while loading) -->
        <ScrollView
            android:id="@+id/dashboardScrollView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbars="none"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Stats Grid Section Header -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="REQUEST STATISTICS"
                    android:textColor="@color/pirma_text_muted"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.1"
                    android:layout_marginBottom="10dp" />

                <!-- Row 1: Total + Pending -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="10dp">

                    <!-- Total Requests Card -->
                    <LinearLayout
                        android:id="@+id/cardTotal"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/bg_input_field"
                        android:backgroundTint="@color/pirma_blue"
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:elevation="2dp">
                        <TextView
                            android:id="@+id/tvTotalCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="@color/white"
                            android:textSize="28sp"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Total"
                            android:textColor="#CCFFFFFF"
                            android:textSize="12sp"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <!-- Pending Card -->
                    <LinearLayout
                        android:id="@+id/cardPending"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_input_field"
                        android:backgroundTint="@color/white"
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:elevation="2dp">
                        <TextView
                            android:id="@+id/tvPendingCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="#A07800"
                            android:textSize="28sp"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Pending"
                            android:textColor="@color/pirma_text_muted"
                            android:textSize="12sp"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                </LinearLayout>

                <!-- Row 2: Approved + For Release -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="10dp">

                    <!-- Approved Card -->
                    <LinearLayout
                        android:id="@+id/cardApproved"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/bg_input_field"
                        android:backgroundTint="@color/white"
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:elevation="2dp">
                        <TextView
                            android:id="@+id/tvApprovedCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="#059669"
                            android:textSize="28sp"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Approved"
                            android:textColor="@color/pirma_text_muted"
                            android:textSize="12sp"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <!-- For Release Card -->
                    <LinearLayout
                        android:id="@+id/cardForRelease"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_input_field"
                        android:backgroundTint="@color/white"
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:elevation="2dp">
                        <TextView
                            android:id="@+id/tvForReleaseCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="#7C3AED"
                            android:textSize="28sp"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="For Release"
                            android:textColor="@color/pirma_text_muted"
                            android:textSize="12sp"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                </LinearLayout>

                <!-- Row 3: Rejected + Pending Payment -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="20dp">

                    <!-- Rejected Card -->
                    <LinearLayout
                        android:id="@+id/cardRejected"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/bg_input_field"
                        android:backgroundTint="@color/white"
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:elevation="2dp">
                        <TextView
                            android:id="@+id/tvRejectedCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="@color/pirma_red"
                            android:textSize="28sp"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Rejected"
                            android:textColor="@color/pirma_text_muted"
                            android:textSize="12sp"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <!-- Pending Payment Card -->
                    <LinearLayout
                        android:id="@+id/cardPendingPayment"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_input_field"
                        android:backgroundTint="@color/white"
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:elevation="2dp">
                        <TextView
                            android:id="@+id/tvPendingPaymentCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="#7C3AED"
                            android:textSize="28sp"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Pending Payment"
                            android:textColor="@color/pirma_text_muted"
                            android:textSize="12sp"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                </LinearLayout>

                <!-- Recent Activity Section -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="RECENT ACTIVITY"
                    android:textColor="@color/pirma_text_muted"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.1"
                    android:layout_marginBottom="10dp" />

                <LinearLayout
                    android:id="@+id/llRecentActivity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_input_field"
                    android:backgroundTint="@color/white"
                    android:elevation="2dp"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:id="@+id/tvNoRecentActivity"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="No recent activity."
                        android:textColor="@color/pirma_text_muted"
                        android:textSize="13sp"
                        android:gravity="center"
                        android:padding="24dp"
                        android:visibility="gone" />

                </LinearLayout>

            </LinearLayout>
        </ScrollView>

        <!-- Full-area loading overlay (sits on top of scroll content) -->
        <FrameLayout
            android:id="@+id/dashboardLoadingOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#F4F6FB"
            android:visibility="visible">

            <ProgressBar
                android:id="@+id/pbDashboardLoading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginTop="40dp" />

        </FrameLayout>

        <!-- Error state overlay -->
        <TextView
            android:id="@+id/tvDashboardError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_margin="24dp"
            android:gravity="center"
            android:textColor="@color/pirma_red"
            android:textSize="14sp"
            android:visibility="gone" />

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

